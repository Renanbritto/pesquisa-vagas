# URLs Principais
NEXT_PUBLIC_API_URL=https://pesquisa-vagas-api.onrender.com
NEXT_PUBLIC_SITE_URL=https://pesquisavagas.vercel.app

# Supabase (Configuração das API Routes do Next.js)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-ou-anon-key

# Telegram Bot
TELEGRAM_BOT_TOKEN=seu_bot_token_aqui
TELEGRAM_WEBHOOK_SECRET=um_segredo_aleatorio_para_validar_o_webhook
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=seu_bot_username

# Opcional: Cloudflare Turnstile (Proteção Anti-Abuso)
# TURNSTILE_SECRET_KEY=sua-secret-key
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=sua-site-key
